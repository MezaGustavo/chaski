# Relay (server/relay.mjs)
CLUSTER=devnet                 # devnet | mainnet-beta
# RPC_URL=https://your-private-rpc.example   # server only
# CLIENT_RPC_URL=https://your-public-rpc.example  # sent to browsers via /config: use a domain-restricted key
# PRIORITY_MICROLAMPORTS=20000 # priority fee per compute unit sent to clients
PORT=8787

# Web (Vite)
# VITE_RELAY_HTTP=https://relay.example.com
